Options -Indexes
RewriteEngine On

# Never serve code, config or tools directly
RewriteRule ^(lib|tools)(/|$) - [F,L]
RewriteRule ^(config\.php|config\.sample\.php|schema\.sql|schema_upgrade_web\.sql|cron\.php|backtest\.php|README\.md)$ - [F,L]

# Short referral links: /r/CODE  ->  web app with the code attached
RewriteRule ^r/([A-Za-z0-9]{4,16})/?$ r.php?c=$1 [L,QSA]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
